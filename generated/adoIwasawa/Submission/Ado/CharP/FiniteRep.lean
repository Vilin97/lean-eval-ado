import Submission.Ado.PBW.Restricted
import Submission.Ado.CharP.Central
import Submission.Ado.CharP.Dispatch

/-!
# Ado's theorem in positive characteristic

Let `K` be a field of characteristic `p > 0` and `L` a finite-dimensional Lie
algebra over `K` with basis `x₁, …, xₙ`.

By `Submission.Ado.exists_pPolynomial_relation_of_ge` there is a single exponent
`q = p^M` with `M ≥ 1` such that every `ad xⱼ` satisfies a `p`-polynomial
relation of that degree; by `Submission.Ado.central_pPolynomial` the
corresponding elements

```
cⱼ = ι(xⱼ)^q − ∑_{t<q} μⱼₜ ι(xⱼ)^t
```

are **central** in `U(L)`. Let `Cⱼ` be the operators by which they act on the
PBW module `Poly K n`, and put

```
N := ∑ⱼ range Cⱼ ,      Q := Poly K n / N .
```

* `N` is stable under the action of `L`, because the `cⱼ` are central, so `L`
  acts on `Q`.
* `Q` is finite-dimensional: by `Submission.Ado.PBW.fam_span` the whole module is
  spanned by `C^m (z^b)` with `b` restricted, and every such element with `m ≠ 0`
  lies in `N`, so `Q` is spanned by the images of the finitely many restricted
  monomials.
* The action on `Q` is faithful: if `x` acted as `0` then
  `ρ(x)(z⁰) = ∑ᵢ (repr x)ᵢ zᵢ` would lie in `N`, and
  `Submission.Ado.PBW.coeff_eq_zero_of_mem_bigCRange` forces every coordinate of
  `x` to vanish.

Combining with `Submission.Ado.hasFaithfulFinRep_of_charP`, which supplies the
characteristic-zero case from `hasFaithfulFinRep_charZero`, gives Ado's theorem
over an arbitrary field.
-/

universe u

namespace Submission.Ado

open UniversalEnvelopingAlgebra PBW

variable {K : Type u} [Field K] {L : Type u} [LieRing L] [LieAlgebra K L] {n : ℕ}

/-! ### Reindexing a `p`-polynomial as a polynomial of degree `< q` -/

/-- Rewriting `∑ᵢ λᵢ f(p^i)` as `∑_{t < p^M} μₜ f(t)`. -/
theorem sum_range_reindex {M : Type u} [AddCommGroup M] [Module K M] {p m : ℕ}
    (hp : 2 ≤ p) (lam : Fin m → K) (f : ℕ → M) :
    ∑ t ∈ Finset.range (p ^ m),
        (∑ i : Fin m, if p ^ (i : ℕ) = t then lam i else 0) • f t
      = ∑ i : Fin m, lam i • f (p ^ (i : ℕ)) := by
  classical
  simp only [Finset.sum_smul, ite_smul, zero_smul]
  rw [Finset.sum_comm]
  refine Finset.sum_congr rfl fun i _ => ?_
  rw [Finset.sum_ite_eq, if_pos (Finset.mem_range.mpr (Nat.pow_lt_pow_right hp i.isLt))]

/-! ### A uniform `p`-polynomial relation for all basis vectors -/

/-- One exponent `M ≥ 1` works for every basis vector at once. -/
theorem exists_uniform_pPolynomial (p : ℕ) [Fact p.Prime] [CharP K p]
    [FiniteDimensional K L] (bas : Module.Basis (Fin n) K L) :
    ∃ (M : ℕ) (lam : Fin n → Fin M → K), 1 ≤ M ∧
      ∀ j, LieAlgebra.ad K L (bas j) ^ p ^ M
        = ∑ i : Fin M, lam j i • LieAlgebra.ad K L (bas j) ^ p ^ (i : ℕ) := by
  classical
  choose m₀ hm₀ hrel using fun j : Fin n =>
    exists_pPolynomial_relation_of_ge p (LieAlgebra.ad K L (bas j))
  refine ⟨1 + Finset.univ.sup m₀, ?_, Nat.le_add_right 1 _, ?_⟩
  · exact fun j => Classical.choose (hrel j _ (le_trans (Finset.le_sup (Finset.mem_univ j))
      (Nat.le_add_left _ 1)))
  · exact fun j => Classical.choose_spec (hrel j _ (le_trans
      (Finset.le_sup (Finset.mem_univ j)) (Nat.le_add_left _ 1)))

/-! ### The setup -/

variable (bas : Module.Basis (Fin n) K L) (q : ℕ) (mu : Fin n → ℕ → K)

/-- The submodule generated by the images of all the `Cⱼ`. -/
noncomputable def bigCRange : Submodule K (Poly K n) :=
  ⨆ j : Fin n, LinearMap.range (bigC bas q mu j)

theorem bigC_mem_bigCRange (j : Fin n) (f : Poly K n) :
    bigC bas q mu j f ∈ bigCRange bas q mu :=
  le_iSup (fun j : Fin n => LinearMap.range (bigC bas q mu j)) j ⟨f, rfl⟩

/-- Central elements commute with the whole action, so `Cⱼ` commutes with `ρ(x)`. -/
theorem rhoL_comm_bigC (hc : CentralElts bas q mu) (x : L) (j : Fin n) :
    rhoL bas x * bigC bas q mu j = bigC bas q mu j * rhoL bas x := by
  rw [bigC, ← envAction_ι bas x, ← map_mul, ← map_mul, hc j (ι K x)]

theorem rhoL_mem_bigCRange (hc : CentralElts bas q mu) (x : L) {f : Poly K n}
    (hf : f ∈ bigCRange bas q mu) : rhoL bas x f ∈ bigCRange bas q mu := by
  have hle : bigCRange bas q mu
      ≤ Submodule.comap (rhoL bas x) (bigCRange bas q mu) := by
    show (⨆ j : Fin n, LinearMap.range (bigC bas q mu j)) ≤ _
    refine iSup_le fun j => ?_
    rintro _ ⟨g, rfl⟩
    have h : rhoL bas x (bigC bas q mu j g) = bigC bas q mu j (rhoL bas x g) :=
      congrArg (fun t : Module.End K (Poly K n) => t g) (rhoL_comm_bigC bas q mu hc x j)
    simpa only [Submodule.mem_comap, h] using bigC_mem_bigCRange bas q mu j _
  exact hle hf

/-! ### The finite-dimensional quotient -/

/-- The quotient of the PBW module by the images of the `Cⱼ`. -/
abbrev QuotMod : Type u := Poly K n ⧸ bigCRange bas q mu

/-- Every basis element with a nonzero multi-index lies in `N`. -/
theorem fam_mem_bigCRange {s : RIndex q n} (hs : s.2 ≠ 0) :
    fam bas q mu s ∈ bigCRange bas q mu := by
  obtain ⟨j, A, hA⟩ := exists_bigC_factor bas q mu hs
  have : fam bas q mu s = bigC bas q mu j (A (mono (s.1 : Mon n))) := by
    rw [fam, hA]; rfl
  rw [this]
  exact bigC_mem_bigCRange bas q mu j _

/-- The quotient is spanned by the images of the restricted monomials. -/
theorem span_mkQ_restricted (hq : 0 < q) :
    Submodule.span K (Set.range fun b : {b : Mon n // IsRestricted q b} =>
      (bigCRange bas q mu).mkQ (mono (b : Mon n))) = ⊤ := by
  refine top_unique fun z _ => ?_
  obtain ⟨f, rfl⟩ := (bigCRange bas q mu).mkQ_surjective z
  have hf : f ∈ Submodule.span K (Set.range (fam bas q mu)) := by
    rw [fam_span bas q mu hq]; exact Submodule.mem_top
  refine Submodule.span_induction ?_ ?_ ?_ ?_ hf
  · rintro _ ⟨s, rfl⟩
    by_cases hs : s.2 = 0
    · refine Submodule.subset_span ⟨s.1, ?_⟩
      have : s = (s.1, 0) := by
        refine Prod.ext rfl ?_
        exact hs
      rw [this, fam_snd_zero]
    · rw [Submodule.mkQ_apply,
        (Submodule.Quotient.mk_eq_zero _).mpr (fam_mem_bigCRange bas q mu hs)]
      exact Submodule.zero_mem _
  · simp
  · intro f g _ _ hf hg; rw [map_add]; exact Submodule.add_mem _ hf hg
  · intro c f _ hf; rw [map_smul]; exact Submodule.smul_mem _ _ hf

theorem finiteDimensional_quotMod (hq : 0 < q) :
    FiniteDimensional K (QuotMod bas q mu) := by
  haveI : Finite {b : Mon n // IsRestricted q b} := instFiniteIsRestricted
  rw [FiniteDimensional, Module.finite_def, Submodule.fg_def]
  exact ⟨Set.range fun b : {b : Mon n // IsRestricted q b} =>
      (bigCRange bas q mu).mkQ (mono (b : Mon n)),
    Set.finite_range _, span_mkQ_restricted bas q mu hq⟩

/-! ### The induced action and its faithfulness -/

/-- The action of `L` on the quotient. -/
noncomputable def repQ (hc : CentralElts bas q mu) (x : L) :
    Module.End K (QuotMod bas q mu) :=
  Submodule.mapQ _ _ (rhoL bas x) fun _ hf => rhoL_mem_bigCRange bas q mu hc x hf

theorem repQ_mkQ (hc : CentralElts bas q mu) (x : L) (f : Poly K n) :
    repQ bas q mu hc x ((bigCRange bas q mu).mkQ f)
      = (bigCRange bas q mu).mkQ (rhoL bas x f) := rfl


/-- Two endomorphisms of the quotient agree as soon as they agree on classes. -/
theorem quot_ext {A B : Module.End K (QuotMod bas q mu)}
    (h : ∀ f : Poly K n,
      A ((bigCRange bas q mu).mkQ f) = B ((bigCRange bas q mu).mkQ f)) : A = B := by
  refine LinearMap.ext fun z => ?_
  obtain ⟨f, rfl⟩ := (bigCRange bas q mu).mkQ_surjective z
  exact h f

/-- The action of `L` on the quotient, as a morphism of Lie algebras. -/
noncomputable def repQHom (hc : CentralElts bas q mu) :
    L →ₗ⁅K⁆ Module.End K (QuotMod bas q mu) where
  toFun := repQ bas q mu hc
  map_add' x y := by
    refine quot_ext bas q mu fun f => ?_
    rw [repQ_mkQ, LinearMap.add_apply, repQ_mkQ, repQ_mkQ, ← map_add, map_add (rhoL bas)]
    rfl
  map_smul' c x := by
    refine quot_ext bas q mu fun f => ?_
    rw [repQ_mkQ, RingHom.id_apply, LinearMap.smul_apply, repQ_mkQ, ← map_smul,
      map_smul (rhoL bas)]
    rfl
  map_lie' {x y} := by
    refine quot_ext bas q mu fun f => ?_
    rw [repQ_mkQ]
    have hbr : ⁅repQ bas q mu hc x, repQ bas q mu hc y⁆ ((bigCRange bas q mu).mkQ f)
        = (bigCRange bas q mu).mkQ (rhoL bas x (rhoL bas y f))
          - (bigCRange bas q mu).mkQ (rhoL bas y (rhoL bas x f)) := by
      show repQ bas q mu hc x (repQ bas q mu hc y ((bigCRange bas q mu).mkQ f))
        - repQ bas q mu hc y (repQ bas q mu hc x ((bigCRange bas q mu).mkQ f)) = _
      rw [repQ_mkQ, repQ_mkQ, repQ_mkQ, repQ_mkQ]
    rw [hbr, ← map_sub]
    refine congrArg _ ?_
    have h := congrArg (fun t : Module.End K (Poly K n) => t f) (rhoL_lie bas x y)
    exact h.symm

@[simp] theorem repQHom_apply (hc : CentralElts bas q mu) (x : L) :
    repQHom bas q mu hc x = repQ bas q mu hc x := rfl

/-- **Faithfulness.** -/
theorem repQHom_injective (hcb : CentralElts bas q mu) (hq : 2 ≤ q) :
    Function.Injective (repQHom bas q mu hcb) := by
  refine injective_of_map_eq_zero _ fun x hx => ?_
  -- the class of `ρ(x) z⁰` vanishes, i.e. `ρ(x) z⁰ ∈ N`
  have h0 : rhoL bas x (mono 0) ∈ bigCRange bas q mu := by
    have hz := congrArg
      (fun t : Module.End K (QuotMod bas q mu) => t ((bigCRange bas q mu).mkQ (mono 0))) hx
    simp only [repQHom_apply, repQ_mkQ, LinearMap.zero_apply] at hz
    exact (Submodule.Quotient.mk_eq_zero _).mp hz
  -- but `ρ(x) z⁰` is the linear form with the coordinates of `x`
  have hval : rhoL bas x (mono 0) = ∑ i : Fin n, bas.repr x i • (mono (e i) : Poly K n) := by
    rw [← envAction_ι bas x]
    exact ev_ι bas x
  rw [hval] at h0
  refine bas.repr.injective (Finsupp.ext fun i => ?_)
  simpa using coeff_eq_zero_of_mem_bigCRange bas q mu hcb hq (fun i => bas.repr x i) h0 i


/-! ### Ado's theorem in positive characteristic -/

/-- **Ado's theorem in characteristic `p`.** Every finite-dimensional Lie algebra
over a field of positive characteristic has a faithful finite-dimensional
representation. -/
theorem hasFaithfulFinRep_charP (p : ℕ) [Fact p.Prime] [CharP K p]
    [FiniteDimensional K L] : HasFaithfulFinRep K L := by
  classical
  set bs := Module.finBasis K L with hbs
  obtain ⟨N, lam, hN1, hrel⟩ := exists_uniform_pPolynomial p bs
  have hp2 : 2 ≤ p := (Fact.out : p.Prime).two_le
  set q : ℕ := p ^ N with hq
  have hq2 : 2 ≤ q := by
    calc 2 ≤ p := hp2
      _ = p ^ 1 := (pow_one p).symm
      _ ≤ p ^ N := Nat.pow_le_pow_right (by omega) hN1
  set mu : Fin (Module.finrank K L) → ℕ → K :=
    fun j t => ∑ i : Fin N, if p ^ (i : ℕ) = t then lam j i else 0 with hmu
  -- the `p`-polynomials are exactly the ones `central_pPolynomial` handles
  have hcElt : ∀ j, cElt bs q mu j
      = (ι K (bs j) : UniversalEnvelopingAlgebra K L) ^ p ^ N
        - ∑ i : Fin N, lam j i • (ι K (bs j) : UniversalEnvelopingAlgebra K L) ^ p ^ (i : ℕ) := by
    intro j
    rw [cElt, hq]
    exact congrArg _ (sum_range_reindex hp2 (lam j)
      fun t => (ι K (bs j) : UniversalEnvelopingAlgebra K L) ^ t)
  have hc : CentralElts bs q mu := by
    intro j u
    rw [hcElt j]
    exact central_pPolynomial p (bs j) (lam j) (hrel j) u
  refine ⟨QuotMod bs q mu, inferInstance, inferInstance,
    finiteDimensional_quotMod bs q mu (by omega), repQHom bs q mu hc, ?_⟩
  exact repQHom_injective bs q mu hc hq2

/-- **Ado's theorem over an arbitrary field.** -/
theorem hasFaithfulFinRep_any [FiniteDimensional K L] : HasFaithfulFinRep K L :=
  hasFaithfulFinRep_of_charP fun p _hp _hcp => hasFaithfulFinRep_charP p

end Submission.Ado
