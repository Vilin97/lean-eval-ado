import Submission.Ado.AugIdeal
import Submission.Ado.DerivRep

/-!
# Extending a derivation of `L` to `U(L)`

A derivation `D` of a Lie algebra `L` extends uniquely to an associative
derivation `D̃` of its universal enveloping algebra `U(L)`. This is the
technical input to Lemma 4.4 of the informal proof, where a derivation of `L`
carrying `L` into an ideal `N` is turned into an operator on the truncated
enveloping algebra `U(L) ⧸ J(L)^k`.

## The construction

No induction over monomials is needed. Work instead in the trivial square-zero
extension `A = U(L) ⋉ U(L)` (`TrivSqZeroExt`), whose multiplication is
`(a, b) * (c, d) = (a * c, a * d + b * c)`. The map

```
f : L → A,   f x = (ι x, ι (D x))
```

is a morphism of Lie algebras: the second component of `⁅f x, f y⁆` is
`ι ⁅x, D y⁆ + ι ⁅D x, y⁆ = ι (D ⁅x, y⁆)`, which is exactly the derivation
hypothesis on `D`. The universal property of `U(L)` promotes `f` to an algebra
morphism `F : U(L) →ₐ[K] A`, whose first component is the identity (both are
algebra maps agreeing on `ι '' L`). Writing `F u = (u, D̃ u)`, the Leibniz rule
for `D̃` is precisely `F (u * v) = F u * F v` read in the second component.

## Main results

* `Submission.Ado.envDeriv` — the extension `D̃`, as a `Module.End`;
* `Submission.Ado.envDeriv_isDeriv`, `Submission.Ado.envDeriv_ι` — its two
  defining properties;
* `Submission.Ado.envDeriv_unique` — a derivation of `U(L)` is determined by its
  values on `ι '' L`;
* `Submission.Ado.envDeriv_genPow_le`, `Submission.Ado.envDeriv_augPow_le` —
  **Lemma 4.4**: `D̃` preserves the degree filtration and hence every power of
  the augmentation ideal;
* `Submission.Ado.envDeriv_mem_augPow_one` — `D̃` always lands in the
  augmentation ideal;
* `Submission.Ado.envDeriv_mem_genIdeal` — if `D L ⊆ N` then `D̃` maps all of
  `U(L)` into the two-sided ideal generated by `N`;
* `Submission.Ado.envDeriv_add`, `Submission.Ado.envDeriv_smul`,
  `Submission.Ado.envDeriv_lie` — `D ↦ D̃` is `K`-linear and sends brackets of
  derivations of `L` to commutators in `U(L)`.

`Mathlib` makes `LieRing.ofAssociativeRing` a *local* instance only, so it is
re-enabled here for the duration of the file.
-/

universe u v

namespace Submission.Ado

open UniversalEnvelopingAlgebra

attribute [local instance 100] LieRing.ofAssociativeRing

variable {K L : Type u} [Field K] [LieRing L] [LieAlgebra K L]

/-! ### Derivations of `U(L)` are determined on generators -/

/-- The commutator of two derivations of an associative algebra is a
derivation. -/
theorem IsDeriv.lie {A : Type v} [Ring A] [Algebra K A] {E₁ E₂ : Module.End K A}
    (h₁ : IsDeriv E₁) (h₂ : IsDeriv E₂) : IsDeriv ⁅E₁, E₂⁆ := by
  intro a b
  simp only [LieRing.of_associative_ring_bracket, LinearMap.sub_apply, Module.End.mul_apply,
    h₁ a b, h₂ a b, map_add, h₁ (E₂ a) b, h₁ a (E₂ b), h₂ (E₁ a) b, h₂ a (E₁ b), sub_mul, mul_sub]
  abel

/-- A derivation of `U(L)` is determined by its values on `ι '' L`. -/
theorem isDeriv_ext {E₁ E₂ : Module.End K (UniversalEnvelopingAlgebra K L)}
    (h₁ : IsDeriv E₁) (h₂ : IsDeriv E₂) (h : ∀ x : L, E₁ (ι K x) = E₂ (ι K x)) : E₁ = E₂ := by
  ext u
  have hu : u ∈ Algebra.adjoin K (Set.range (ι K : L → UniversalEnvelopingAlgebra K L)) := by
    rw [adjoin_range_ι_eq_top K L]; trivial
  induction hu using Algebra.adjoin_induction with
  | mem x hx => obtain ⟨y, rfl⟩ := hx; exact h y
  | algebraMap r => rw [Algebra.algebraMap_eq_smul_one, map_smul, map_smul, h₁.map_one, h₂.map_one]
  | add x y _ _ hx hy => rw [map_add, map_add, hx, hy]
  | mul x y _ _ hx hy => rw [h₁ x y, h₂ x y, hx, hy]

/-! ### The square-zero extension and the extended derivation -/

/-- The trivial square-zero extension of `U(L)` by itself; its multiplication is
`(a, b) * (c, d) = (a * c, a * d + b * c)`. -/
abbrev EnvSq (K L : Type u) [Field K] [LieRing L] [LieAlgebra K L] : Type u :=
  TrivSqZeroExt (UniversalEnvelopingAlgebra K L) (UniversalEnvelopingAlgebra K L)

variable (D : L →ₗ[K] L) (hD : ∀ x y : L, D ⁅x, y⁆ = ⁅D x, y⁆ + ⁅x, D y⁆)

/-- `x ↦ (ι x, ι (D x))` is a morphism of Lie algebras into the square-zero
extension `U(L) ⋉ U(L)`. -/
noncomputable def envLieHom : L →ₗ⁅K⁆ EnvSq K L where
  toFun x := (ι K x, ι K (D x))
  map_add' x y := by ext <;> simp
  map_smul' t x := by ext <;> simp
  map_lie' := by
    intro x y
    rw [LieRing.of_associative_ring_bracket]
    ext
    · simp only [TrivSqZeroExt.fst_sub, TrivSqZeroExt.fst_mul, TrivSqZeroExt.fst_mk]
      rw [← LieRing.of_associative_ring_bracket, ← LieHom.map_lie]
    · simp only [TrivSqZeroExt.snd_sub, TrivSqZeroExt.snd_mul, TrivSqZeroExt.fst_mk,
        TrivSqZeroExt.snd_mk, smul_eq_mul, MulOpposite.smul_eq_mul_unop, MulOpposite.unop_op]
      rw [hD, map_add, LieHom.map_lie, LieHom.map_lie,
        LieRing.of_associative_ring_bracket, LieRing.of_associative_ring_bracket]
      abel

theorem envLieHom_apply (x : L) : envLieHom D hD x = (ι K x, ι K (D x)) := rfl

/-- The algebra morphism `U(L) →ₐ[K] U(L) ⋉ U(L)` obtained from `envLieHom` by
the universal property. -/
noncomputable def envAlgHom : UniversalEnvelopingAlgebra K L →ₐ[K] EnvSq K L :=
  lift K (envLieHom D hD)

theorem envAlgHom_ι (x : L) : envAlgHom D hD (ι K x) = (ι K x, ι K (D x)) :=
  lift_ι_apply K (envLieHom D hD) x

/-- The first component of `envAlgHom` is the identity: both are algebra
morphisms agreeing on `ι '' L`. -/
@[simp]
theorem envAlgHom_fst (u : UniversalEnvelopingAlgebra K L) :
    (envAlgHom D hD u).fst = u := by
  have h : (TrivSqZeroExt.fstHom K (UniversalEnvelopingAlgebra K L)
        (UniversalEnvelopingAlgebra K L)).comp (envAlgHom D hD)
      = AlgHom.id K (UniversalEnvelopingAlgebra K L) := by
    apply hom_ext
    ext x
    simp [envAlgHom, envLieHom_apply]
  exact AlgHom.congr_fun h u

/-- **The extension of `D` to `U(L)`.** -/
noncomputable def envDeriv : Module.End K (UniversalEnvelopingAlgebra K L) where
  toFun u := (envAlgHom D hD u).snd
  map_add' u v := by simp
  map_smul' t u := by simp

theorem envDeriv_apply (u : UniversalEnvelopingAlgebra K L) :
    envDeriv D hD u = (envAlgHom D hD u).snd := rfl

/-- **`envDeriv D` satisfies the Leibniz rule.** -/
theorem envDeriv_isDeriv : IsDeriv (envDeriv D hD) := by
  intro a b
  simp only [envDeriv_apply, map_mul, TrivSqZeroExt.snd_mul, envAlgHom_fst, smul_eq_mul,
    MulOpposite.smul_eq_mul_unop, MulOpposite.unop_op]
  exact add_comm _ _

/-- **`envDeriv D` extends `D`.** -/
theorem envDeriv_ι (x : L) : envDeriv D hD (ι K x) = ι K (D x) := by
  rw [envDeriv_apply, envAlgHom_ι, TrivSqZeroExt.snd_mk]

@[simp]
theorem envDeriv_one : envDeriv D hD 1 = 0 := (envDeriv_isDeriv D hD).map_one

/-- `envDeriv D` is the *unique* derivation of `U(L)` extending `D`. -/
theorem envDeriv_unique {E : Module.End K (UniversalEnvelopingAlgebra K L)} (hE : IsDeriv E)
    (h : ∀ x : L, E (ι K x) = ι K (D x)) : E = envDeriv D hD :=
  isDeriv_ext hE (envDeriv_isDeriv D hD) fun x => by rw [h, envDeriv_ι]

/-! ### Lemma 4.4: stability of the filtration -/

/-- `envDeriv D` carries the span of `ι '' L` into itself. -/
theorem envDeriv_gen_le : gen K L ≤ (gen K L).comap (envDeriv D hD) := by
  rw [gen, Submodule.span_le]
  rintro _ ⟨x, rfl⟩
  simp only [SetLike.mem_coe, Submodule.mem_comap, envDeriv_ι]
  exact ι_mem_gen K L (D x)

theorem envDeriv_mem_gen {u : UniversalEnvelopingAlgebra K L} (hu : u ∈ gen K L) :
    envDeriv D hD u ∈ gen K L :=
  envDeriv_gen_le D hD hu

/-- **Lemma 4.4, degree form.** `envDeriv D` preserves every stage of the degree
filtration: the Leibniz rule replaces one of the `k` generators in a product by
another element of `gen`. -/
theorem envDeriv_genPow_le (k : ℕ) :
    ∀ u ∈ gen K L ^ k, envDeriv D hD u ∈ gen K L ^ k := by
  induction k with
  | zero =>
      intro u hu
      rw [pow_zero] at hu ⊢
      obtain ⟨r, rfl⟩ := Submodule.mem_one.mp hu
      rw [Algebra.algebraMap_eq_smul_one, map_smul, envDeriv_one, smul_zero]
      exact Submodule.zero_mem _
  | succ k ih =>
      intro u hu
      rw [pow_succ] at hu ⊢
      refine Submodule.mul_induction_on hu ?_ ?_
      · intro m hm n hn
        rw [envDeriv_isDeriv D hD m n]
        exact Submodule.add_mem _ (Submodule.mul_mem_mul (ih m hm) hn)
          (Submodule.mul_mem_mul hm (envDeriv_mem_gen D hD hn))
      · intro x y hx hy
        rw [map_add]
        exact Submodule.add_mem _ hx hy

/-- **Lemma 4.4.** `envDeriv D` preserves every power of the augmentation
ideal. -/
theorem envDeriv_augPow_le (k : ℕ) :
    ∀ u ∈ augPow K L k, envDeriv D hD u ∈ augPow K L k := by
  have h : augPow K L k ≤ (augPow K L k).comap (envDeriv D hD) := by
    rw [augPow_def]
    refine iSup_le fun j => fun v hv => ?_
    exact Submodule.mem_comap.mpr
      (genPow_le_augPow K L (Nat.le_add_left k j) (envDeriv_genPow_le D hD (j + k) v hv))
  exact fun u hu => h hu

/-- `envDeriv D` always lands in the augmentation ideal: it kills the scalars,
and sends a product of `j ≥ 1` generators into `gen ^ j`. -/
theorem envDeriv_mem_augPow_one (u : UniversalEnvelopingAlgebra K L) :
    envDeriv D hD u ∈ augPow K L 1 := by
  have h : (⊤ : Submodule K (UniversalEnvelopingAlgebra K L))
      ≤ (augPow K L 1).comap (envDeriv D hD) := by
    rw [← iSup_gen_pow_eq_top K L]
    refine iSup_le fun j v hv => ?_
    rcases Nat.eq_zero_or_pos j with rfl | hj
    · rw [pow_zero] at hv
      obtain ⟨r, rfl⟩ := Submodule.mem_one.mp hv
      simp only [Submodule.mem_comap, Algebra.algebraMap_eq_smul_one, map_smul, envDeriv_one,
        smul_zero]
      exact Submodule.zero_mem _
    · exact Submodule.mem_comap.mpr
        (genPow_le_augPow K L hj (envDeriv_genPow_le D hD j v hv))
  exact h trivial

/-! ### The ideal generated by a submodule of `L` -/

/-- The two-sided ideal of `U(L)` generated by the image of a submodule
`N ≤ L`. -/
def genIdeal (N : Submodule K L) : Submodule K (UniversalEnvelopingAlgebra K L) :=
  (⊤ : Submodule K (UniversalEnvelopingAlgebra K L)) *
      Submodule.map ((ι K : L →ₗ⁅K⁆ UniversalEnvelopingAlgebra K L) : L →ₗ[K] _) N *
    (⊤ : Submodule K (UniversalEnvelopingAlgebra K L))

theorem ι_mem_genIdeal {N : Submodule K L} {x : L} (hx : x ∈ N) :
    (ι K x : UniversalEnvelopingAlgebra K L) ∈ genIdeal N := by
  have h : (1 : UniversalEnvelopingAlgebra K L) * ι K x * 1 ∈ genIdeal N :=
    Submodule.mul_mem_mul
      (Submodule.mul_mem_mul Submodule.mem_top (Submodule.mem_map_of_mem hx)) Submodule.mem_top
  simpa using h

theorem top_mul_genIdeal_le (N : Submodule K L) :
    (⊤ : Submodule K (UniversalEnvelopingAlgebra K L)) * genIdeal N ≤ genIdeal N := by
  rw [genIdeal, ← mul_assoc, ← mul_assoc]
  exact mul_le_mul' (mul_le_mul' le_top le_rfl) le_rfl

theorem genIdeal_mul_top_le (N : Submodule K L) :
    genIdeal N * (⊤ : Submodule K (UniversalEnvelopingAlgebra K L)) ≤ genIdeal N := by
  rw [genIdeal, mul_assoc]
  exact mul_le_mul' le_rfl le_top

/-- **Lemma 4.4, ideal form.** If `D` maps `L` into `N`, then `envDeriv D` maps
all of `U(L)` into the two-sided ideal generated by `N`. -/
theorem envDeriv_mem_genIdeal {N : Submodule K L} (hDN : ∀ x : L, D x ∈ N)
    (u : UniversalEnvelopingAlgebra K L) : envDeriv D hD u ∈ genIdeal N := by
  have hu : u ∈ Algebra.adjoin K (Set.range (ι K : L → UniversalEnvelopingAlgebra K L)) := by
    rw [adjoin_range_ι_eq_top K L]; trivial
  induction hu using Algebra.adjoin_induction with
  | mem x hx =>
      obtain ⟨y, rfl⟩ := hx
      rw [envDeriv_ι]
      exact ι_mem_genIdeal (hDN y)
  | algebraMap r =>
      rw [Algebra.algebraMap_eq_smul_one, map_smul, envDeriv_one, smul_zero]
      exact Submodule.zero_mem _
  | add x y _ _ hx hy =>
      rw [map_add]
      exact Submodule.add_mem _ hx hy
  | mul x y _ _ hx hy =>
      rw [envDeriv_isDeriv D hD]
      exact Submodule.add_mem _
        (genIdeal_mul_top_le N (Submodule.mul_mem_mul hx Submodule.mem_top))
        (top_mul_genIdeal_le N (Submodule.mul_mem_mul Submodule.mem_top hy))

/-! ### Functoriality in `D` -/

variable (D₁ D₂ : L →ₗ[K] L)
  (hD₁ : ∀ x y : L, D₁ ⁅x, y⁆ = ⁅D₁ x, y⁆ + ⁅x, D₁ y⁆)
  (hD₂ : ∀ x y : L, D₂ ⁅x, y⁆ = ⁅D₂ x, y⁆ + ⁅x, D₂ y⁆)

theorem envDeriv_add (h : ∀ x y : L, (D₁ + D₂) ⁅x, y⁆ = ⁅(D₁ + D₂) x, y⁆ + ⁅x, (D₁ + D₂) y⁆) :
    envDeriv (D₁ + D₂) h = envDeriv D₁ hD₁ + envDeriv D₂ hD₂ := by
  refine (envDeriv_unique _ _ ?_ ?_).symm
  · intro a b
    simp only [LinearMap.add_apply, envDeriv_isDeriv D₁ hD₁ a b, envDeriv_isDeriv D₂ hD₂ a b,
      add_mul, mul_add]
    abel
  · intro x
    simp only [LinearMap.add_apply, envDeriv_ι, map_add]

theorem envDeriv_smul (t : K) (h : ∀ x y : L, (t • D₁) ⁅x, y⁆ = ⁅(t • D₁) x, y⁆ + ⁅x, (t • D₁) y⁆) :
    envDeriv (t • D₁) h = t • envDeriv D₁ hD₁ := by
  refine (envDeriv_unique _ _ ?_ ?_).symm
  · intro a b
    simp only [LinearMap.smul_apply, envDeriv_isDeriv D₁ hD₁ a b, smul_add, smul_mul_assoc,
      mul_smul_comm]
  · intro x
    simp only [LinearMap.smul_apply, envDeriv_ι, map_smul]

/-- `D ↦ envDeriv D` sends the bracket of two derivations of `L` to the
commutator of their extensions. -/
theorem envDeriv_lie (h : ∀ x y : L, ⁅D₁, D₂⁆ ⁅x, y⁆ = ⁅⁅D₁, D₂⁆ x, y⁆ + ⁅x, ⁅D₁, D₂⁆ y⁆) :
    envDeriv ⁅D₁, D₂⁆ h = ⁅envDeriv D₁ hD₁, envDeriv D₂ hD₂⁆ := by
  refine (envDeriv_unique _ _ ((envDeriv_isDeriv D₁ hD₁).lie (envDeriv_isDeriv D₂ hD₂)) ?_).symm
  intro x
  simp only [LieRing.of_associative_ring_bracket, LinearMap.sub_apply, Module.End.mul_apply,
    envDeriv_ι, map_sub]

end Submission.Ado
